# Google Cloud OAuth Web Client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/oauth/google/callback

# 32 random bytes, base64 encoded. Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BRIDGE_ENCRYPTION_KEY=

# Owner/admin token. Generate a long random value.
BRIDGE_OWNER_TOKEN=

# JSON map of MCP agents and their bearer token + allowed capabilities.
# Example:
# {"chatgpt":{"token":"replace-me","scopes":["accounts.read","gmail.read","calendar.read","drive.read"]},"email-monitor":{"token":"replace-me-2","scopes":["accounts.read","gmail.read"]}}
BRIDGE_AGENTS_JSON={}

PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
